# Local development only. Keep actual values in your shell or an ignored .env file.
# Supply a generated password before starting resources/compose.postgres.yml.
AAII_POSTGRES_PASSWORD=
AAII_POSTGRES_DATABASE=additional_market_data
AAII_POSTGRES_USER=market_data
AAII_POSTGRES_PORT=55432
AAII_POSTGRES_BIND_HOST=127.0.0.1
# URI-encode reserved characters in a PostgreSQL password used in a DSN.
MARKET_DATA_POSTGRES_DSN=
REG_SHO_POSTGRES_PASSWORD=

# Local Dagster UI; used by scripts/run_local_dagster.sh.
DAGSTER_PORT=3030

# NAAIM delayed-public local operations. The reference is nonsecret; keep the
# actual local value out of Git with the rest of this runtime configuration.
NAAIM_SCHEDULED_LIVE_ACCESS=false
NAAIM_DELAYED_ROOT=data/naaim-exposure-public-delayed
NAAIM_PERMISSION_REFERENCE=

# Optional per-pipeline Slack incoming-webhook secrets. Leave empty until enabled
# in that pipeline's alerts.local.yml; never put the URLs in committed YAML.
AAII_SLACK_WEBHOOK_URL=
NAAIM_EXPOSURE_PUBLIC_DELAYED_SLACK_WEBHOOK_URL=
SEC_FAILS_TO_DELIVER_SLACK_WEBHOOK_URL=
REG_SHO_THRESHOLDS_SLACK_WEBHOOK_URL=
FOMC_MEETING_MINUTES_SLACK_WEBHOOK_URL=
